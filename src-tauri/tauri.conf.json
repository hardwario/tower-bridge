{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOWER Bridge",
  "mainBinaryName": "tower-bridge",
  "identifier": "com.hardwario.tower-bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "publisher": "HARDWARIO a.s.",
    "copyright": "© 2026 HARDWARIO a.s.",
    "category": "Utility",
    "shortDescription": "TOWER Bridge Module sensor monitor",
    "longDescription": "Shows temperature, humidity, illuminance and pressure from the HARDWARIO TOWER Climate Module connected through the TOWER Bridge Module.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
